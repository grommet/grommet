.c4:focus-visible .c13 >rect {
  outline: none;
  box-shadow: 0 0 2px 2px #6FFFB0;
}

.c4:focus-visible .c13 ::-moz-focus-inner {
  border: 0;
}

.c4:not([aria-disabled]):active .c13 {
  transform: scale(0.95);
}

.c4:not([aria-disabled]):hover .c13 {
  background: color-mix(in srgb, #7D4CDB 90%, black 10%);
  border: solid 2px color-mix(in srgb, #7D4CDB 90%, black 10%);
  color: #FFFFFF;
}

.c11 {
  grid-column: 1;
  grid-row: 1/span 3;
  align-self: stretch;
  width: 2px;
  border-radius: 6px;
  pointer-events: none;
  justify-self: center;
  margin-inline-start: 3px;
  margin-top: calc(3px + 24px + 2px * 2 + 4px);
  margin-bottom: calc(4px - 3px - 24px);
  background: rgba(0, 0, 0, 0.33);
}

@media only screen and (max-width: 768px) {
  .c3 {
    border: solid 0px rgba(0, 0, 0, 0.33);
  }
}

@media only screen and (max-width: 768px) {
  .c3 {
    padding: 2px;
  }
}

@media only screen and (max-width: 768px) {
  .c6 {
    border: solid 2px #666666;
  }
}

@media only screen and (max-width: 768px) {
  .c12 {
    border: solid 2px #7D4CDB;
  }
}

<div
  class="c0"
>
  <ol
    aria-label="Progress"
    class="c1"
    style="list-style: none;"
  >
    <li
      class="c2"
    >
      <button
        aria-label="Step 1 of 3: Step 1"
        class="c3 c4 c5"
        tabindex="-1"
        type="button"
      >
        <div
          class="c6 c7"
        />
        <div
          class="c8 c9"
        >
          <span
            class="c10 StyledStepper__StyledStepLabel-sc-gmpe0p-4"
          >
            Step 1
          </span>
        </div>
      </button>
      <span
        aria-hidden="true"
        class="c11"
        direction="vertical"
      />
    </li>
    <li
      class="c2"
    >
      <button
        aria-current="step"
        aria-label="Step 2 of 3: Step 2"
        class="c3 c4 c5"
        tabindex="0"
        type="button"
      >
        <div
          class="c12 c13"
        >
          <svg
            aria-hidden="true"
            aria-label="Status is okay"
            class="c14"
            viewBox="0 0 12 12"
          >
            <circle
              cx="6"
              cy="6"
              fill-rule="evenodd"
              r="5"
              stroke="#000"
            />
          </svg>
        </div>
        <div
          class="c8 c9"
        >
          <span
            class="c15 StyledStepper__StyledStepLabel-sc-gmpe0p-4"
          >
            Step 2
          </span>
        </div>
      </button>
      <span
        aria-hidden="true"
        class="c11"
        direction="vertical"
      />
    </li>
    <li
      class="c2"
    >
      <button
        aria-label="Step 3 of 3: Step 3"
        class="c3 c4 c5"
        tabindex="-1"
        type="button"
      >
        <div
          class="c6 c7"
        />
        <div
          class="c8 c9"
        >
          <span
            class="c10 StyledStepper__StyledStepLabel-sc-gmpe0p-4"
          >
            Step 3
          </span>
        </div>
      </button>
    </li>
  </ol>
</div>
`;
