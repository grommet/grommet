.c5:focus-visible .c8 >path,
.c5:focus-visible .c8 >polygon,
.c5:focus-visible .c8 >polyline,
.c5:focus-visible .c8 >rect {
  outline: none;
  box-shadow: 0 0 2px 2px #6FFFB0;
}

.c5:focus-visible .c8 ::-moz-focus-inner {
  border: 0;
}

.c5:not([aria-disabled]):active .c8 {
  transform: scale(0.95);
}

.c5:not([aria-disabled]):hover .c8 {
  background: color-mix(in srgb, #FFFFFF 90%, black 10%);
  border: solid 2px color-mix(in srgb, #666666 90%, black 10%);
  color: #000000;
}

.c14 {
  box-sizing: content-box;
  flex-direction: row;
  color: #FFFFFF;
}

.c14::before {
  content: '\\200b';
  font-size: 18px;
  line-height: 24px;
}

.c5:focus-visible .c14 {
  outline: none;
  box-shadow: 0 0 2px 2px #6FFFB0;
}

.c5:focus-visible .c14 >circle,
.c5:focus-visible .c14 >ellipse,
.c5:focus-visible .c14 >line,
.c5:focus-visible .c14 >path,
.c5:focus-visible .c14 >polygon,
.c5:focus-visible .c14 >polyline,
.c5:focus-visible .c14 >rect {
  outline: none;
  box-shadow: 0 0 2px 2px #6FFFB0;
}

.c5:focus-visible .c14 ::-moz-focus-inner {
  border: 0;
}

.c5:not([aria-disabled]):active .c14 {
  transform: scale(0.95);
}

.c5:not([aria-disabled]):hover .c14 {
  background: color-mix(in srgb, #7D4CDB 90%, black 10%);
  border: solid 2px color-mix(in srgb, #7D4CDB 90%, black 10%);
  color: #FFFFFF;
}

.c12 {
  grid-column: 1;
  grid-row: 1/span 3;
  align-self: stretch;
  width: 2px;
  border-radius: 6px;
  pointer-events: none;
  justify-self: center;
  margin-inline-start: 3px;
  margin-top: calc(3px + 24px + 2px * 2 + 4px);
  margin-bottom: calc(4px - 3px - 24px);
  background: rgba(0, 0, 0, 0.33);
}

@media only screen and (max-width: 768px) {
  .c1 {
    margin: 0px;
  }
}

@media only screen and (max-width: 768px) {
  .c1 {
    padding: 0px;
  }
}

@media only screen and (max-width: 768px) {
